  "programs": [
    {
      "id": "prog-p2",
      "code": "P2",
      "name": "Programme 2026",
      "active": true,
      "sessions": [
        {
          "id": "ses-A",
          "code": "A",
          "name": "Dominante quadriceps & pressée inclinée",
          "items": [
            {
              "id": "it-dominante-qu-1",
              "exerciseId": "squat-barre",
              "sets": 4,
              "repMin": 6,
              "repMax": 8,
              "targetRirMin": 2,
              "targetRirMax": 2,
              "notes": "Descente contrôlée 2 s, cuisses au parallèle ou en dessous. Le mouvement le plus lourd de la semaine : il passe en premier, à froid mais échauffé."
            },
            {
              "id": "it-dominante-qu-2",
              "exerciseId": "developpe-incline-halteres-30",
              "sets": 3,
              "repMin": 8,
              "repMax": 10,
              "targetRirMin": 1,
              "targetRirMax": 2,
              "notes": "Angle mesuré, pas « à peu près » : au-delà de 30° le travail glisse vers le deltoïde antérieur. Amplitude complète, étirement marqué en bas."
            },
            {
              "id": "it-dominante-qu-3",
              "exerciseId": "traction-pronation-lestee",
              "sets": 3,
              "repMin": 6,
              "repMax": 10,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Coudes tirés vers les hanches, omoplates serrées. Ceinture de lest dès que 10 reps propres passent. Excentrique 3 s. Si tu as grimpé la veille : arrête-toi à 2 RIR, ne va pas à l'échec."
            },
            {
              "id": "it-dominante-qu-4",
              "exerciseId": "elevations-laterales-halteres",
              "sets": 3,
              "repMin": 12,
              "repMax": 15,
              "targetRirMin": 0,
              "targetRirMax": 1,
              "notes": "Buste très légèrement penché, coudes menant le mouvement, pas de balancier. L'exercice qui construit la largeur."
            },
            {
              "id": "it-dominante-qu-5",
              "exerciseId": "leg-curl-assis",
              "sets": 3,
              "repMin": 10,
              "repMax": 12,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Assis plutôt qu'allongé : hanche fléchie = ischio-jambiers en position allongée, meilleur stimulus."
            },
            {
              "id": "it-dominante-qu-6",
              "exerciseId": "pull-over-a-la-poulie-haute",
              "sets": 3,
              "repMin": 12,
              "repMax": 15,
              "targetRirMin": 0,
              "targetRirMax": 1,
              "notes": "Bras quasi tendus : du grand dorsal sans fléchisseurs du coude. C'est la série qui finance le V-taper — et la seule qui charge le dos sans rien ajouter à un coude déjà chargé par le bloc."
            },
            {
              "id": "it-dominante-qu-7",
              "exerciseId": "drapeau-du-dragon",
              "sets": 3,
              "repMin": 5,
              "repMax": 8,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Régression si besoin : genoux fléchis, puis jambes tendues. Sinon relevés de jambes suspendu, jambes tendues, sans élan."
            }
          ]
        },
        {
          "id": "ses-B",
          "code": "B",
          "name": "Dominante chaîne postérieure & pressée décliné",
          "items": [
            {
              "id": "it-dominante-ch-1",
              "exerciseId": "souleve-de-terre-roumain",
              "sets": 4,
              "repMin": 8,
              "repMax": 10,
              "targetRirMin": 2,
              "targetRirMax": 2,
              "notes": "Le hip hinge de la vidéo, enfin chargeable. Jambes quasi tendues, barre qui frôle les cuisses, descente jusqu'à l'étirement des ischios — pas plus bas."
            },
            {
              "id": "it-dominante-ch-2",
              "exerciseId": "dips-lestes",
              "sets": 3,
              "repMin": 6,
              "repMax": 10,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Buste penché en avant pour orienter la charge vers les pectoraux. Descente jusqu'à l'étirement, sans forcer l'épaule."
            },
            {
              "id": "it-dominante-ch-3",
              "exerciseId": "rowing-haltere-un-bras",
              "sets": 3,
              "repMin": 8,
              "repMax": 12,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Prise neutre, tirage vers la hanche. Le remplaçant chargeable du rowing inversé : rhomboïdes, grand rond, trapèzes."
            },
            {
              "id": "it-dominante-ch-4",
              "exerciseId": "developpe-militaire-halteres-assis",
              "sets": 3,
              "repMin": 8,
              "repMax": 10,
              "targetRirMin": 1,
              "targetRirMax": 2,
              "notes": "Conservé pour la force et le deltoïde antérieur — mais ce n'est pas lui qui élargit. Dos calé, pas de cambrure."
            },
            {
              "id": "it-dominante-ch-5",
              "exerciseId": "fente-bulgare",
              "sets": 3,
              "repMin": 8,
              "repMax": 10,
              "targetRirMin": 1,
              "targetRirMax": 2,
              "notes": "Remplace le pistol squat : même travail unilatéral, mais la charge progresse indéfiniment sans être limitée par l'équilibre."
            },
            {
              "id": "it-dominante-ch-6",
              "exerciseId": "elevations-laterales-a-la-poulie",
              "sets": 3,
              "repMin": 15,
              "repMax": 20,
              "targetRirMin": 0,
              "targetRirMax": 0,
              "notes": "Deuxième dose hebdomadaire, en séries longues. La poulie maintient la tension en bas d'amplitude, là où les haltères la perdent."
            },
            {
              "id": "it-dominante-ch-7",
              "exerciseId": "face-pull-a-la-poulie",
              "sets": 3,
              "repMin": 15,
              "repMax": 20,
              "targetRirMin": 0,
              "targetRirMax": 1,
              "notes": "Deltoïde postérieur et rotateurs externes : l'antagoniste direct de la posture d'escalade, épaules enroulées vers l'avant. Coudes hauts, mains qui finissent au niveau des oreilles."
            },
            {
              "id": "it-dominante-ch-8",
              "exerciseId": "curl-inverse-barre-ez",
              "sets": 2,
              "repMin": 12,
              "repMax": 15,
              "targetRirMin": 1,
              "targetRirMax": 1,
              "notes": "Prise pronation : brachio-radial et extenseurs du poignet. Remplace le curl supination — il fait le travail de bras et le contrepoids des fléchisseurs de doigts sursollicités par le bloc."
            }
          ]
        }
      ]
    }
  ],
